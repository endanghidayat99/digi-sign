# ====== DigiSign — konfigurasi production ======
# install.sh mengisi otomatis semua nilai GANTI_OTOMATIS dengan rahasia acak
# (dan menampilkan sandi admin sekali). Yang WAJIB Anda isi sendiri: APP_PUBLIC_BASE_URL.

# Diisi otomatis oleh build.sh / install.sh
APP_TAG=latest
POSTGRES_IMAGE=postgres:16-alpine

# --- Alamat publik ---
# URL yang dibuka saat QR di-scan -> {APP_PUBLIC_BASE_URL}/verify/{token}, tanpa '/' di akhir.
# WAJIB bisa diakses dari HP pemindai (domain publik, atau intranet jika verifikasi hanya internal).
# Nilai ini TERTANAM PERMANEN di QR — tentukan sebelum mulai menandatangani dokumen.
APP_PUBLIC_BASE_URL=
# Port aplikasi di host. 127.0.0.1 = hanya untuk reverse proxy/TLS di server yang sama;
# 0.0.0.0 = bisa diakses langsung dari jaringan.
APP_BIND=127.0.0.1
APP_PORT=8080
APP_TIMEZONE=Asia/Makassar

# --- Admin awal (dibuat hanya jika belum ada user sama sekali) ---
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=GANTI_OTOMATIS
APP_ADMIN_FULLNAME=Administrator

# --- PostgreSQL ---
DB_NAME=digisign
DB_USERNAME=digisign
DB_PASSWORD=GANTI_OTOMATIS
DB_POOL_SIZE=10

# --- Rahasia aplikasi ---
APP_JWT_SECRET=GANTI_OTOMATIS
APP_JWT_EXPIRATION_MINUTES=480
# Kunci segel tanda tangan. JANGAN diganti setelah ada dokumen ditandatangani (segel lama jadi tidak sah).
APP_SIGNATURE_SECRET=GANTI_OTOMATIS

# --- Lain-lain ---
# true = halaman verifikasi publik boleh menampilkan/unduh PDF
APP_PUBLIC_DOWNLOAD=false
MAX_UPLOAD_SIZE=25MB
