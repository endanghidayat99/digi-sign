# Untuk docker-compose.yml lokal. Production: deploy/.env.example (diisi otomatis oleh install.sh)
# Salin menjadi .env lalu sesuaikan:  cp .env.example .env

# ---- Database ----
DB_NAME=digisign
DB_USERNAME=digisign
DB_PASSWORD=ganti-password-db

# ---- Aplikasi ----
APP_PORT=8080
# URL yang dibuka saat QR di-scan -> {APP_PUBLIC_BASE_URL}/verify/{token}
# WAJIB alamat yang bisa diakses dari HP pemindai (domain/IP publik atau intranet)
APP_PUBLIC_BASE_URL=https://esign.perusahaan.co.id
APP_TIMEZONE=Asia/Makassar

# Rahasia — buat dengan: openssl rand -base64 48
APP_JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter-xxxxxxxx
# Kunci segel tanda tangan. JANGAN diubah setelah ada dokumen ditandatangani.
APP_SIGNATURE_SECRET=ganti-dengan-string-acak-lain-minimal-32-karakter-yy
APP_JWT_EXPIRATION_MINUTES=480

# Admin awal (hanya dibuat jika belum ada user sama sekali)
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=ganti-password-admin
APP_ADMIN_FULLNAME=Administrator

# true = halaman verifikasi publik boleh menampilkan/unduh PDF
APP_PUBLIC_DOWNLOAD=false
MAX_UPLOAD_SIZE=25MB
